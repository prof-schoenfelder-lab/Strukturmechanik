      "boundElements": [],
      "updated": 1761562206149,
      "link": null,
      "locked": false,
      "text": "- PULL \n    - Durchmesser ändern (Rohrdicke ändern Lenker)\n- MOVE\n    - Länge ändern (Kurbellänge + Dicke ändern)\n- SPLIT BODY\n    - Teilen mit Ebenen / Geometrien (Bimetall)\n- SELECT & DELETE\n    - Fahrradrahmen Bohrungen & zusätzliche Teile entfernen",
      "fontSize": 28,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- PULL \n    - Durchmesser ändern (Rohrdicke ändern Lenker)\n- MOVE\n    - Länge ändern (Kurbellänge + Dicke ändern)\n- SPLIT BODY\n    - Teilen mit Ebenen / Geometrien (Bimetall)\n- SELECT & DELETE\n    - Fahrradrahmen Bohrungen & zusätzliche Teile entfernen",
      "autoResize": true,
      "lineHeight": 1.25
    },
